{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"85d0c06b8a88cd630930255d52ed57e5f2d5d00c20a21759e215146650e2fc1f","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","completeTranslationApiLink":"/api/mar_irv/complete.json","simpleCompleteTranslationApiLink":"/api/mar_irv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"aa9992e9044abe62040af9e0ea501ae39bd631a99057582d6591dd86a4c74494","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","firstChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","lastChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["प्राप्तःकाळची देवावरील श्रद्धासूचक प्रार्थना"]},{"type":"hebrew_subtitle","content":["दावीदाचे स्तोत्र; जेव्हा तो आपला मुलगा अबशालोम याच्यापुढून पळाला."]},{"type":"verse","number":1,"content":[{"text":"परमेश्वरा, माझे शत्रू पुष्कळ आहेत!","poem":1},{"lineBreak":true},{"text":"पुष्कळ वळले आणि माझ्यावर हल्ला केला आहे.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"“परमेश्वराकडून त्यास काहीएक मदत होणार नाही,”","poem":1},{"lineBreak":true},{"text":"असे माझ्याविरूद्ध बोलणारे पुष्कळ आहेत. सेला","poem":1},{"noteId":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"परंतु हे परमेश्वरा, तू माझ्या सभोवती ढाल असा आहेस,","poem":1},{"lineBreak":true},{"text":"तू माझे वैभव, आणि माझे डोके वर करणारा आहे.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"मी माझा आवाज परमेश्वराकडे उंच करीन,","poem":1},{"lineBreak":true},{"text":"आणि तो मला त्याच्या पवित्र डोंगरावरून उत्तर देईल. सेला","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"मी अंग टाकून झोपी गेलो;","poem":1},{"lineBreak":true},{"text":"मी जागा झालो, कारण परमेश्वर माझे रक्षण करतो.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"जे सर्वबाजूंनी माझ्यासाठी टपून बसले आहेत,","poem":1},{"lineBreak":true},{"text":"त्या लोकसमुदायला मी घाबरणार नाही.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"हे परमेश्वरा उठ, माझ्या देवा, मला तार!","poem":1},{"lineBreak":true},{"text":"कारण तू माझ्या सर्व शत्रूंच्या थोबाडीत मारली आहेस,","poem":1},{"lineBreak":true},{"text":"तू दुष्टांचे दात पाडले आहेत.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"तारण","poem":1},{"noteId":2},{"text":"परमेश्वरापासूनच आहे,","poem":1},{"lineBreak":true},{"text":"तुझ्या लोकांवर तुझा आशीर्वाद असो. सेला.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"अल्पविराम","reference":{"chapter":3,"verse":2}},{"noteId":2,"caller":"+","text":"विजय","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/mar_irv/PSA/3.json","thisChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/4.json","nextChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/2.json","previousChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":8,"simpleChapterApiLink":"/api/mar_irv/PSA/3.simple.json"}