{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"85d0c06b8a88cd630930255d52ed57e5f2d5d00c20a21759e215146650e2fc1f","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","completeTranslationApiLink":"/api/mar_irv/complete.json","simpleCompleteTranslationApiLink":"/api/mar_irv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"aa9992e9044abe62040af9e0ea501ae39bd631a99057582d6591dd86a4c74494","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","firstChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","lastChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"heading","content":["शुद्धतेसाठी प्रार्थना"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; दाविदाचे स्तोत्र; जेव्हा तो बथशेबापाशी गेल्यानंतर नाथान भविष्यवादी त्याच्याकडे आला तेव्हाचे."]},{"type":"verse","number":1,"content":[{"text":"हे देवा, तू आपल्या प्रेमदयेमुळे माझ्यावर दया कर,","poem":1},{"lineBreak":true},{"text":"तुझ्या पुष्कळ दयाळूपणाच्या कृत्यांनी माझ्या अपराधांचे डाग पुसून टाक.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"देवा माझे अपराध धुऊन टाक,","poem":1},{"lineBreak":true},{"text":"आणि मला माझ्या पापांपासून शुद्ध कर.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"कारण माझे अपराध मला माहित आहेत.","poem":1},{"lineBreak":true},{"text":"आणि माझी पातके नित्य माझ्यासमोर आहेत.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"तुझ्याविरूद्ध, फक्त तुझ्याविरूद्ध मी पाप केले आहे,","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या दृष्टीने जे वाईट ते मी केले आहे.","poem":1},{"lineBreak":true},{"text":"जेव्हा तू बोलतोस तर तू सत्य बोलतो.","poem":1},{"lineBreak":true},{"text":"तू न्याय करतो तेव्हा योग्य करतो.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"पाहा! मी जन्मापासूनच पापी आहे,","poem":1},{"lineBreak":true},{"text":"आणि पापांतच माझ्या आईने माझा गर्भ धारण केला.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"पाहा! तू माझ्या हृदयात सत्यतेची इच्छा धरतो,","poem":1},{"lineBreak":true},{"text":"तू माझ्या हृदयास ज्ञानाची ओळख करून दे.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"मला शुध्द करण्यासाठी तू एजोब वनस्पती वापर,","poem":1},{"lineBreak":true},{"text":"मी शुद्ध होईन, मला धुऊन शुद्ध कर आणि मी बर्फापेक्षा शुद्ध होईन.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"आनंद व हर्ष मला ऐकू दे,","poem":1},{"lineBreak":true},{"text":"म्हणजे तू मोडलेली माझी हाडे हर्ष करतील.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"माझ्या पापांकडे बघू नकोस,","poem":1},{"lineBreak":true},{"text":"माझ्या सर्व अपराधांचे डाग पुसून टाक.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"देवा, माझ्याठायी पवित्र हृदय निर्माण कर.","poem":1},{"lineBreak":true},{"text":"आणि माझ्या मध्ये स्थीर असा आत्मा पुन्हा घाल.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"तुझ्या उपस्थितीतून मला दूर लोटू नकोस,","poem":1},{"lineBreak":true},{"text":"आणि तुझा पवित्र आत्मा माझ्यातून काढून घेऊ नकोस.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"तू केलेल्या तारणाचा आनंद मला पुन्हा होऊ दे,","poem":1},{"lineBreak":true},{"text":"आणि उत्सुक आत्म्याने मला सावरून धर.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"तेव्हा मी पापी लोकांस तुझे मार्ग शिकविन","poem":1},{"lineBreak":true},{"text":"आणि पापी तुझ्याकडे परिवर्तित होतील.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"हे माझ्या तारणाऱ्या देवा, रक्तपाताच्या दोषापासून मला क्षमा कर,","poem":1},{"lineBreak":true},{"text":"आणि मी तुझ्या न्यायीपणाबद्दल मोठ्याने ओरडेन.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"प्रभू, माझे ओठ उघड,","poem":1},{"lineBreak":true},{"text":"आणि माझे तोंड तुझी स्तुती वर्णन करेल.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"कारण यज्ञाची आवड तुला नाही,","poem":1},{"lineBreak":true},{"text":"नाहीतर मी ते दिले असते,","poem":1},{"lineBreak":true},{"text":"होमार्पणाने तुला संतोष होत नाही.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"देवाचा यज्ञ म्हणजे, तुटलेले हृदय,","poem":1},{"lineBreak":true},{"text":"तुटलेले आणि पश्चातापी हृदय तू तुच्छ मानणार नाहीस.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"हे देवा, तू प्रसन्न होऊन सियोनेचे चांगले कर.","poem":1},{"lineBreak":true},{"text":"आणि यरूशलेमेच्या भींती पुन्हा बांध.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"तेव्हा न्यायीपणाचे यज्ञ, होमार्पणे, आणि सकल होमार्पणे तुला आवडतील.","poem":1},{"lineBreak":true},{"text":"तेव्हा तुझ्या वेदीवर बैल अर्पिले जातील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/51.json","thisChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":51},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/52.json","nextChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":52},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/50.json","previousChapterReference":{"translationId":"mar_irv","book":"PSA","chapter":50},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":19,"simpleChapterApiLink":"/api/mar_irv/PSA/51.simple.json"}