{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"7f91bb5092ff8c89e9d553a999799e909788a42aeadc835c81c1dd0761e9fb72","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","completeTranslationApiLink":"/api/tam_irv/complete.json","simpleCompleteTranslationApiLink":"/api/tam_irv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"027eef01fdf0ec431ee1bebc809c8f980291c4523e2788cdb270aa97898bd9d4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","firstChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","lastChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீது எழுதிய பாடல். பத்சேபாளோடு தாவீது செய்த பாவத்திற்குப் பிறகு தீர்க்கதரிசியாகிய நாத்தான் தாவீதிடம் சென்று உணர்த்தியபோது இது பாடப்பட்டது."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, உமது கிருபையின்படி எனக்கு இரங்கும்,","poem":1},{"lineBreak":true},{"text":"உமது மிகுந்த இரக்கங்களின்படி என் மீறுதல்கள் நீங்க என்னைச் சுத்திகரியும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"என் அக்கிரமம் நீங்க என்னை முற்றிலும் கழுவி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாவம்போக என்னைச் சுத்திகரியும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"என்னுடைய மீறுதல்களை நான் அறிந்திருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாவம் எப்பொழுதும் எனக்கு முன்பாக நிற்கிறது.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"தேவனே உம் ஒருவருக்கே விரோதமாக நான் பாவம்செய்து,","poem":1},{"lineBreak":true},{"text":"உமது கண்களுக்கு முன்பாகப் பொல்லாங்கானதை செய்தேன்;","poem":1},{"lineBreak":true},{"text":"நீர் பேசும்போது உம்முடைய நீதி வெளிப்படவும், நீர் நியாயந்தீர்க்கும்போது,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பரிசுத்தம் வெளிப்படவும் இதை அறிக்கையிடுகிறேன்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"இதோ, நான் அநீதியில் உருவானேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய தாய் என்னைப் பாவத்தில் கர்ப்பந்தரித்தாள்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"இதோ, உள்ளத்தில் உண்மையிருக்க விரும்புகிறீர்;","poem":1},{"lineBreak":true},{"text":"உள்ளத்தில் ஞானத்தை எனக்குத் தெரியப்படுத்துவீர்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"நீர் என்னை ஈசோப்பினால் சுத்திகரியும்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் சுத்தமாவேன்;","poem":1},{"lineBreak":true},{"text":"என்னைக் கழுவியருளும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் உறைந்த மழையிலும் வெண்மையாவேன்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"நான் சந்தோஷமும் மகிழ்ச்சியும் கேட்கும்படிச் செய்யும்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நீர் நொறுக்கின எலும்புகள் சந்தோஷப்படும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"என்னுடைய பாவங்களைப் பார்க்காதபடி நீர் உமது முகத்தை மறைத்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய அக்கிரமங்களையெல்லாம் நீக்கியருளும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"தேவனே, சுத்த இருதயத்தை என்னிலே உருவாக்கும், நிலையான ஆவியை என்னுடைய உள்ளத்திலே புதுப்பியும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"உமது சமுகத்தை விட்டு என்னைத் தள்ளாமலும்,","poem":1},{"lineBreak":true},{"text":"உமது பரிசுத்த ஆவியை என்னிடத்திலிருந்து எடுத்துக்கொள்ளாமலும் இரும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"உமது இரட்சிப்பின் சந்தோஷத்தைத் திரும்பவும் எனக்குத் தந்து,","poem":1},{"lineBreak":true},{"text":"உற்சாகமான ஆவி என்னைத் தாங்கும்படி செய்யும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"அப்பொழுது தீயவர்களுக்கு உமது வழிகளை உபதேசிப்பேன்;","poem":1},{"lineBreak":true},{"text":"பாவிகள் உம்மிடத்தில் மனந்திரும்புவார்கள்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"தேவனே, என்னை இரட்சிக்கும் தேவனே,","poem":1},{"lineBreak":true},{"text":"இரத்தப்பழிகளுக்கு என்னை நீங்கலாக்கிவிடும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது என்னுடைய நாவு உம்முடைய நீதியைக் கெம்பீரமாகப் பாடும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"ஆண்டவரே, என்னுடைய உதடுகளைத் திறந்தருளும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது என்னுடைய வாய் உம்முடைய புகழை அறிவிக்கும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"பலியை நீர் விரும்புகிறதில்லை, விரும்பினால் செலுத்துவேன்;","poem":1},{"lineBreak":true},{"text":"தகனபலியும் உமக்குப் பிரியமானதல்ல.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"தேவனுக்கேற்கும் பலிகள் நொறுங்குண்ட ஆவிதான்;","poem":1},{"lineBreak":true},{"text":"தேவனே, நொறுங்குண்டதும் வருந்துகிறதுமான இருதயத்தை நீர் தள்ளிவிடுவதில்லை.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"சீயோனுக்கு உமது பிரியத்தின்படி நன்மை செய்யும்;","poem":1},{"lineBreak":true},{"text":"எருசலேமின் மதில்களைக் கட்டும்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"அப்பொழுது தகனபலியும் சர்வாங்க தகனபலியுமாகிய","poem":1},{"lineBreak":true},{"text":"நீதியின் பலிகளில் பிரியப்படுவீர்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது உமது பீடத்தின்மேல் காளைகளைப் பலியிடுவார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/51.json","thisChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":51},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/52.json","nextChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":52},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/50.json","previousChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":50},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":19,"simpleChapterApiLink":"/api/tam_irv/PSA/51.simple.json"}