{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"7f91bb5092ff8c89e9d553a999799e909788a42aeadc835c81c1dd0761e9fb72","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","completeTranslationApiLink":"/api/tam_irv/complete.json","simpleCompleteTranslationApiLink":"/api/tam_irv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"027eef01fdf0ec431ee1bebc809c8f980291c4523e2788cdb270aa97898bd9d4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","firstChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","lastChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["தன் மகனாகிய அப்சலோமிடமிருந்து தப்பிச் சென்றபோது தாவீது பாடிய பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என்னுடைய எதிரிகள் எவ்வளவாகப் பெருகியிருக்கிறார்கள்!","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாக எழும்புகிறவர்கள் அநேகர்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"தேவனிடத்தில் அவனுக்கு சகாயம் இல்லை என்று,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவைக் குறித்துச் சொல்லுகிறவர்கள் அநேகராக இருக்கிறார்கள். (சேலா)","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"ஆனாலும் யெகோவாவே, நீர் என்னைச் சூழ்ந்துள்ள கேடகமும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய மகிமையும், என்னுடைய தலையை உயர்த்துகிறவருமாக இருக்கிறீர்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"நான் யெகோவா வை நோக்கிச் சத்தமிட்டுக் கூப்பிட்டேன்;","poem":1},{"lineBreak":true},{"text":"அவர் தமது பரிசுத்த மலையிலிருந்து எனக்கு பதில் கொடுத்தார். (சேலா)","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"நான் படுத்து தூங்கினேன்; விழித்துக்கொண்டேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவா என்னைத் தாங்குகிறார்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"எனக்கு விரோதமாகச் சுற்றிலும் படையெடுத்துவருகிற பத்தாயிரம்பேருக்கும்","poem":1},{"lineBreak":true},{"text":"நான் பயப்படமாட்டேன்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே, எழுந்தருளும்;","poem":1},{"lineBreak":true},{"text":"என் தேவனே, என்னை காப்பாற்றும்.","poem":1},{"lineBreak":true},{"text":"நீர் என்னுடைய பகைவர்கள் எல்லோரையும் தாடையிலே அடித்து,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய பற்களைத் தகர்த்துப்போட்டீர்.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"ஜெயம் யெகோவாவுடையது;","poem":1},{"lineBreak":true},{"text":"தேவனே உம்முடைய ஆசீர்வாதம்","poem":1},{"lineBreak":true},{"text":"உம்முடைய மக்களின்மேல் இருப்பதாக (சேலா).","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/3.json","thisChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/4.json","nextChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/2.json","previousChapterReference":{"translationId":"tam_irv","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":8,"simpleChapterApiLink":"/api/tam_irv/PSA/3.simple.json"}