{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"0ae481d3257ba895a57748179fc194012ffbfd500c141f9c3ef042a4db4771c6","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","completeTranslationApiLink":"/api/rus_syn/complete.json","simpleCompleteTranslationApiLink":"/api/rus_syn/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"e62d3dc6e880ec6e368dddb5c78ada932240d86d48b244417ae5c8951145dcf8","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","firstChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","lastChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":150},"totalNumberOfVerses":2526},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":[{"text":"Начальнику хора. Учение Давида,","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"после того, как приходил Доик Идумеянин и донес Саулу и сказал ему, что Давид пришел в дом Ахимелеха.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Что хвалишься злодейством, сильный? милость Божия всегда со мною;","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"гибель вымышляет язык твой; как изощренная бритва, он у тебя, коварный!","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"ты любишь больше зло, нежели добро, больше ложь, нежели говорить правду;","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"ты любишь всякие гибельные речи, язык коварный:","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"за то Бог сокрушит тебя вконец, изринет тебя и исторгнет тебя из жилища твоего и корень твой из земли живых.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Увидят праведники и убоятся, посмеются над ним и скажут:","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"“вот человек, который не в Боге полагал крепость свою, а надеялся на множество богатства своего, укреплялся в злодействе своем”.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"А я, как зеленеющая маслина, в доме Божием, и уповаю на милость Божию во веки веков,","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"вечно буду славить Тебя за то, что Ты соделал, и уповать на имя Твое, ибо оно благо пред святыми Твоими.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/51.json","thisChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":51},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/52.json","nextChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":52},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/50.json","previousChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":50},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":11,"simpleChapterApiLink":"/api/rus_syn/PSA/51.simple.json"}