{"translation":{"id":"rus_syn","name":"Синодальный перевод","website":"https://ebible.org/Scriptures/details.php?id=russyn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=russyn","shortName":"SYN","englishName":"Russian Synodal Bible","language":"rus","textDirection":"ltr","sha256":"0ae481d3257ba895a57748179fc194012ffbfd500c141f9c3ef042a4db4771c6","availableFormats":["json"],"listOfBooksApiLink":"/api/rus_syn/books.json","completeTranslationApiLink":"/api/rus_syn/complete.json","simpleCompleteTranslationApiLink":"/api/rus_syn/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"русский","languageEnglishName":"Russian"},"book":{"id":"PSA","translationId":"rus_syn","name":"Псалтырь","commonName":"Псалтырь","title":"Псалтырь","order":19,"numberOfChapters":150,"sha256":"e62d3dc6e880ec6e368dddb5c78ada932240d86d48b244417ae5c8951145dcf8","firstChapterNumber":1,"firstChapterApiLink":"/api/rus_syn/PSA/1.json","firstChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/rus_syn/PSA/150.json","lastChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":150},"totalNumberOfVerses":2526},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давида, когда он бежал от Авессалома, сына своего.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Господи! как умножились враги мои! Многие восстают на меня","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"многие говорят душе моей: “нет ему спасения в Боге”.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Но Ты, Господи, щит предо мною, слава моя, и Ты возносишь голову мою.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Гласом моим взываю к Господу, и Он слышит меня со святой горы Своей.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Ложусь я, сплю и встаю, ибо Господь защищает меня.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Не убоюсь тем народа, которые со всех сторон ополчились на меня.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Восстань, Господи! спаси меня, Боже мой! ибо Ты поражаешь в ланиту всех врагов моих; сокрушаешь зубы нечестивых.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"От Господа спасение. Над народом Твоим благословение Твое.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/rus_syn/PSA/3.json","thisChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/rus_syn/PSA/4.json","nextChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/rus_syn/PSA/2.json","previousChapterReference":{"translationId":"rus_syn","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":9,"simpleChapterApiLink":"/api/rus_syn/PSA/3.simple.json"}