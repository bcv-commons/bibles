{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"27ea4ae8044b8fc852e558ec7cad016d4013b51f698fbe8c0311b5605651a377","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","completeTranslationApiLink":"/api/asm_irv/complete.json","simpleCompleteTranslationApiLink":"/api/asm_irv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"62860fde0bdcb61eca377e10f8683ba7fe5f6efef2030e371ea7bc0098d00074","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","firstChapterReference":{"translationId":"asm_irv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","lastChapterReference":{"translationId":"asm_irv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["পুত্ৰ অবচালোমৰ ওচৰৰ পৰা পলাই যোৱাৰ সময়ত দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা চোৱা, মোৰ শত্রুৰ সংখ্যা কিমান বাঢ়িছে!","poem":1},{"lineBreak":true},{"text":"মোৰ বিৰুদ্ধে অনেকেই উঠিছে!","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"অনেকে মোক কৈছে, “ঈশ্বৰে তোমাক সহায়","poem":1},{"noteId":3},{"text":"নকৰে।” (চেলা","poem":1},{"noteId":4},{"text":")","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"কিন্তু, হে যিহোৱা, তুমিয়েই মোৰ চাৰিওফালে ঢাল হৈ আছা;","poem":1},{"lineBreak":true},{"text":"তুমিয়েই মোৰ গৌৰৱ;","poem":1},{"lineBreak":true},{"text":"তুমি মোৰ মূৰ উর্দ্ধত ৰাখিছা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"মই চিঞঁৰি চিঞঁৰি যিহোৱাক মাতো;","poem":1},{"lineBreak":true},{"text":"তাতে তেওঁ মোক তেওঁৰ পবিত্ৰ পৰ্ব্বতৰ পৰা উত্তৰ দিয়ে। (চেলা)","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"মই শুই পৰিলো আৰু টোপনি গলোঁ; পুনৰ সাৰ পালোঁ;","poem":1},{"lineBreak":true},{"text":"কিয়নো যিহোৱাই মোক ৰক্ষা কৰে।","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"মোৰ বিৰুদ্ধে মোৰ চাৰিওফালে হাজাৰ হাজাৰ লোক সজ্জিত হৈ আছে,","poem":1},{"lineBreak":true},{"text":"কিন্তু মই তেওঁলোকলৈ ভয় নকৰোঁ।","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"হে যিহোৱা উঠি আহাঁ!","poem":1},{"lineBreak":true},{"text":"হে মোৰ ঈশ্বৰ, মোক উদ্ধাৰ কৰা;","poem":1},{"lineBreak":true},{"text":"তুমি মোৰ শত্রুবোৰৰ গালত আঘাত কৰা;","poem":1},{"lineBreak":true},{"text":"দুষ্টবোৰৰ দাঁত ভাঁঙি পেলোৱা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"পৰিত্ৰাণ","poem":1},{"noteId":5},{"text":"যিহোৱাতে আছে;","poem":1},{"lineBreak":true},{"text":"তোমাৰ লোকসকলৰ ওপৰত তোমাৰ আশীৰ্ব্বাদ নামি আহঁক। (চেলা)","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"উদ্ধাৰ","reference":{"chapter":3,"verse":2}},{"noteId":4,"caller":"+","text":"‘চেলা’ শব্দটো গীতমালাৰ 71 ঠাইত উল্লেখ আছে, ই গীতৰ মাজৰ বিৰতিক নির্দেশ কৰে।","reference":{"chapter":3,"verse":2}},{"noteId":5,"caller":"+","text":"বিজয়","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/asm_irv/PSA/3.json","thisChapterReference":{"translationId":"asm_irv","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/4.json","nextChapterReference":{"translationId":"asm_irv","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/2.json","previousChapterReference":{"translationId":"asm_irv","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudio