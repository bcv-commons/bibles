{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"27ea4ae8044b8fc852e558ec7cad016d4013b51f698fbe8c0311b5605651a377","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","completeTranslationApiLink":"/api/asm_irv/complete.json","simpleCompleteTranslationApiLink":"/api/asm_irv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"62860fde0bdcb61eca377e10f8683ba7fe5f6efef2030e371ea7bc0098d00074","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","firstChapterReference":{"translationId":"asm_irv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","lastChapterReference":{"translationId":"asm_irv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: দায়ুদৰ ৰচিত গীত। বৎচেবাৰ লগত ব্যভিচাৰ কৰাৰ পাছত যেতিয়া নাথন ভাববাদী দায়ুদৰ ওচৰলৈ আহিছিল সেই সময়ৰ গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, তোমাৰ অসীম প্রেম অনুসাৰে মোক কৃপা কৰা,","poem":1},{"lineBreak":true},{"text":"তোমাৰ প্ৰচুৰ দয়া অনুসাৰে মোৰ পাপ মোচন কৰা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"মোৰ সকলো অধৰ্ম তুমি ধুই পেলোৱা;","poem":1},{"lineBreak":true},{"text":"মোৰ পাপৰ পৰা মোক শুচি কৰা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"মোৰ পাপবোৰ মই নিজে জানিছোঁ;","poem":1},{"lineBreak":true},{"text":"মোৰ পাপ সদায় মোৰ আগত আছে।","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"তোমাৰ বিৰুদ্ধে, কেৱল তোমাৰেই বিৰুদ্ধে মই পাপ কৰিলোঁ;","poem":1},{"lineBreak":true},{"text":"তোমাৰ দৃষ্টিত যি বেয়া মই তাকে কৰিলোঁ;","poem":1},{"lineBreak":true},{"text":"তুমি তোমাৰ বাক্যত ধাৰ্মিক, তোমাৰ বিচাৰ নিখুঁত।","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"চোৱা, অধৰ্মতে মোৰ জন্ম হল; মোৰ মাতৃয়ে মোক পাপতে গৰ্ভধাৰণ কৰিলে।","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"তুমি হৃদয়ৰ মাজত সত্যতাক চাব বিচাৰা;","poem":1},{"lineBreak":true},{"text":"সেয়ে, তুমিয়েই মোৰ গোপন হৃদয়ত শিক্ষা দিবা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"এচোব বনেৰে তুমি মোক পবিত্র কৰা","poem":1},{"noteId":46},{"text":"আৰু মই শুচি হ’ম;","poem":1},{"lineBreak":true},{"text":"মোক ধোৱা, তাতে মই হিমতকৈয়ো বগা হ’ম।","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"মোক আনন্দ আৰু উল্লাসৰ ধ্বনি শুনিবলৈ দিয়া;","poem":1},{"lineBreak":true},{"text":"তুমি গুড়ি কৰা মোৰ অস্থিবোৰক উল্লাসিত হবলৈ দিয়া।","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"মোৰ পাপ সমূহৰ পৰা তুমি তোমাৰ মুখ ঢাকা;","poem":1},{"lineBreak":true},{"text":"মোৰ সকলো অপৰাধ মোচন কৰা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"হে ঈশ্বৰ, তুমি মোৰ ভিতৰত শুদ্ধ অন্তৰ সৃষ্টি কৰা;","poem":1},{"lineBreak":true},{"text":"মোৰ অন্তৰত এক নতুন আৰু সুস্থিৰ আত্মা স্থাপন কৰা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"তোমাৰ সন্মুখৰ পৰা মোক দূৰ নকৰিবা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ পবিত্ৰ আত্মা মোৰ পৰা নিনিবা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"তোমাৰ পৰিত্ৰাণৰ আনন্দ মোক পুনৰায় দান কৰা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ উদাৰ আত্মা দি মোক ধৰি ৰাখা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"তেতিয়া মই পাপীবোৰক তোমাৰ পথৰ বিষয়ে শিক্ষা দিম,","poem":1},{"lineBreak":true},{"text":"তাতে পাপী লোক তোমাৰ ফালে ঘূৰিব।","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"হে ঈশ্বৰ, হে মোৰ পৰিত্ৰাণৰ ঈশ্বৰ,","poem":1},{"lineBreak":true},{"text":"ৰক্তপাতৰ দোষৰ পৰা তুমি মোক উদ্ধাৰ কৰা;","poem":1},{"lineBreak":true},{"text":"তাতে মোৰ জিভাই তোমাৰ উদ্ধাৰৰ গীত উচ্চস্বৰে গাব।","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"হে প্ৰভু, মোৰ ওঁঠ মুকলি কৰা;","poem":1},{"lineBreak":true},{"text":"মোৰ মুখে তোমাৰ প্ৰশংসা প্ৰচাৰ কৰিব।","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"কিয়নো তুমি বলিদানত সন্তুষ্ট নোহোৱা; হোৱা হ’লে মই তাক দিলোহেঁতেন;","poem":1},{"lineBreak":true},{"text":"হোমবলিতো তুমি সন্তুষ্ট নোহোৱা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"ভগ্ন মন ঈশ্বৰৰ গ্ৰহণীয় বলি, ইয়াক দিয়া","poem":1},{"noteId":47},{"text":";","poem":1},{"lineBreak":true},{"text":"হে ঈশ্বৰ, ভগ্ন আৰু অনুতাপী মনক তুমি অগ্ৰাহ্য নকৰিবা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"তোমাৰ মংগলময় ইচ্ছাৰে তুমি চিয়োনৰ মঙ্গল কৰা;","poem":1},{"lineBreak":true},{"text":"যিৰূচালেমৰ প্রাচীৰ তুমি পুনৰ নিৰ্ম্মাণ কৰা।","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"তেতিয়া ধাৰ্মিকতাৰ বলি উৎসর্গ,","poem":1},{"lineBreak":true},{"text":"হোমবলি উৎসর্গ আৰু পূৰ্ণাহুতি হোমবলি উৎসর্গত","poem":1},{"lineBreak":true},{"text":"তুমি আনন্দিত হ’বা।","poem":1},{"lineBreak":true},{"text":"তাৰ পাছত তোমাৰ যজ্ঞবেদীৰ ওপৰত লোকসকলে দামুৰি উৎসৰ্গ কৰিব।","poem":1}]}],"footnotes":[{"noteId":46,"caller":"+","text":"মোৰ পাপ গুচাই দিয়া","reference":{"chapter":51,"verse":7}},{"noteId":47,"caller":"+","text":"অহ! ঈশ্বৰ মোৰ ভগ্ন মনৰ বলি গ্ৰহণ কৰা","reference":{"chapter":51,"verse":17}}]},"thisChapterLink":"/api/asm_irv/PSA/51.json","thisChapterReference":{"translationId":"asm_irv","book":"PSA","chapter":51},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/52.json","nextCha