{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"81164e0052ad8f5bbf8b8eb290d18653e636bc509faa63331d57c1e12cdbbbd4","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","completeTranslationApiLink":"/api/HINIRV/complete.json","simpleCompleteTranslationApiLink":"/api/HINIRV/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"1afd8793dd52016836fb25311128ab7aa363df0b7f5060f85d4d70daaf92a99b","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","firstChapterReference":{"translationId":"HINIRV","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","lastChapterReference":{"translationId":"HINIRV","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["संकट के समय आत्म-विश्वास"]},{"type":"hebrew_subtitle","content":["दाऊद का भजन। जब वह अपने पुत्र अबशालोम के सामने से भागा जाता था"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा मेरे सतानेवाले कितने बढ़ गए हैं!","poem":1},{"lineBreak":true},{"text":"वे जो मेरे विरुद्ध उठते हैं बहुत हैं।","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"बहुत से मेरे विषय में कहते हैं,","poem":1},{"lineBreak":true},{"text":"कि उसका बचाव परमेश्वर की ओर से नहीं हो सकता3:2 उसका बचाव परमेश्वर की ओर से नहीं हो सकता: वह पूर्णतः त्यागा हुआ है उसमें आत्मरक्षा का सामर्थ्य नहीं है और परमेश्वर हस्तक्षेप करके उसे बचाने की इच्छा नहीं रखता है।। (सेला)","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"परन्तु हे यहोवा, तू तो मेरे चारों ओर मेरी ढाल है,","poem":1},{"lineBreak":true},{"text":"तू मेरी महिमा और मेरे मस्तक का ऊँचा करनेवाला है3:3 मेरे मस्तक का ऊँचा करनेवाला है: परेशानियों और दुःख में सिर अपने आप ही झुक जाता है जैसे कि कष्टों के बोझ से दब गया हो।।","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"मैं ऊँचे शब्द से यहोवा को पुकारता हूँ,","poem":1},{"lineBreak":true},{"text":"और वह अपने पवित्र पर्वत पर से मुझे उत्तर देता है। (सेला)","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"मैं लेटकर सो गया;","poem":1},{"lineBreak":true},{"text":"फिर जाग उठा, क्योंकि यहोवा मुझे सम्भालता है।","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"मैं उस भीड़ से नहीं डरता,","poem":1},{"lineBreak":true},{"text":"जो मेरे विरुद्ध चारों ओर पाँति बाँधे खड़े हैं।","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"उठ, हे यहोवा! हे मेरे परमेश्वर मुझे बचा ले!","poem":1},{"lineBreak":true},{"text":"क्योंकि तूने मेरे सब शत्रुओं के जबड़ों पर मारा है।","poem":1},{"lineBreak":true},{"text":"और तूने दुष्टों के दाँत तोड़ डाले हैं।","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"उद्धार यहोवा ही की ओर से होता है3:8 उद्धार यहोवा ही की ओर से होता है: केवल परमेश्वर ही है जो बचा लेता है।;","poem":1},{"lineBreak":true},{"text":"हे यहोवा तेरी आशीष तेरी प्रजा पर हो।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/3.json","thisChapterReference":{"translationId":"HINIRV","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/4.json","nextChapterReference":{"translationId":"HINIRV","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/2.json","previousChapterReference":{"translationId":"HINIRV","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{}