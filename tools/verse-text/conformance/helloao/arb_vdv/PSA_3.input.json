{"translation":{"id":"arb_vdv","name":"الكتاب المقدس باللغة العربية، فان دايك","website":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arb-vd","shortName":"VDV","englishName":"Arabic Van Dyck Bible","language":"arb","textDirection":"rtl","sha256":"a7dbde0da2118c438758bca1706ea71c5c2e4cec72eb996463e4c761c9f6bffb","availableFormats":["json"],"listOfBooksApiLink":"/api/arb_vdv/books.json","completeTranslationApiLink":"/api/arb_vdv/complete.json","simpleCompleteTranslationApiLink":"/api/arb_vdv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"arb_vdv","name":"اَلْمَزَامِيرُ","commonName":"المَزامِير","title":"اَلْمَزَامِيرُ","order":19,"numberOfChapters":150,"sha256":"2f5cafa2da943dabdbf800c3707753b5ced89423803534ef7ce9fc7d80106d03","firstChapterNumber":1,"firstChapterApiLink":"/api/arb_vdv/PSA/1.json","firstChapterReference":{"translationId":"arb_vdv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/arb_vdv/PSA/150.json","lastChapterReference":{"translationId":"arb_vdv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["مَزْمُورٌ لِدَاوُدَ حِينَمَا هَرَبَ مِنْ وَجْهِ أَبْشَالُومَ ٱبْنِهِ"]},{"type":"verse","number":1,"content":["يَارَبُّ، مَا أَكْثَرَ مُضَايِقِيَّ! كَثِيرُونَ قَائِمُونَ عَلَيَّ."]},{"type":"verse","number":2,"content":["كَثِيرُونَ يَقُولُونَ لِنَفْسِي: «لَيْسَ لَهُ خَلَاصٌ بِإِلَهِهِ». سِلَاهْ."]},{"type":"verse","number":3,"content":["أَمَّا أَنْتَ يَارَبُّ فَتُرْسٌ لِي. مَجْدِي وَرَافِعُ رَأْسِي."]},{"type":"verse","number":4,"content":["بِصَوْتِي إِلَى ٱلرَّبِّ أَصْرُخُ، فَيُجِيبُنِي مِنْ جَبَلِ قُدْسِهِ. سِلَاهْ."]},{"type":"verse","number":5,"content":["أَنَا ٱضْطَجَعْتُ وَنِمْتُ. ٱسْتَيْقَظْتُ لِأَنَّ ٱلرَّبَّ يَعْضُدُنِي."]},{"type":"verse","number":6,"content":["لَا أَخَافُ مِنْ رِبْوَاتِ ٱلشُّعُوبِ ٱلْمُصْطَفِّينَ عَلَيَّ مِنْ حَوْلِي."]},{"type":"verse","number":7,"content":["قُمْ يَارَبُّ! خَلِّصْنِي يَا إِلَهِي! لِأَنَّكَ ضَرَبْتَ كُلَّ أَعْدَائِي عَلَى ٱلْفَكِّ. هَشَّمْتَ أَسْنَانَ ٱلْأَشْرَارِ."]},{"type":"verse","number":8,"content":["لِلرَّبِّ ٱلْخَلَاصُ عَلَى شَعْبِكَ بَرَكَتُكَ. سِلَاهْ."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/3.json","thisChapterReference":{"translationId":"arb_vdv","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/4.json","nextChapterReference":{"translationId":"arb_vdv","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/2.json","previousChapterReference":{"translationId":"arb_vdv","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":8,"simpleChapterApiLink":"/api/arb_vdv/PSA/3.simple.json"}