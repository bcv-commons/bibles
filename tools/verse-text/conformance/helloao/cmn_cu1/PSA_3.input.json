{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"695cd78273e0ae8b7d4d8652df136647b8176716ed7279584f6bd047574676ff","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","completeTranslationApiLink":"/api/cmn_cu1/complete.json","simpleCompleteTranslationApiLink":"/api/cmn_cu1/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"5b0940ed754218d066d154fc363276ff3bd7cbcc75f1f003dd9ec97171117347","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","firstChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","lastChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":150},"totalNumberOfVerses":2452},"chapter":{"number":3,"content":[{"type":"heading","content":["求助的晨祷"]},{"type":"hebrew_subtitle","content":["大卫逃避他儿子押沙龙的时候作的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我的敌人何其加增；","poem":1},{"lineBreak":true},{"text":"有许多人起来攻击我。","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"有许多人议论我说：","poem":1},{"lineBreak":true},{"text":"他得不着 神的帮助。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"但你—耶和华是我四围的盾牌，","poem":1},{"lineBreak":true},{"text":"是我的荣耀，又是叫我抬起头来的。","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"我用我的声音求告耶和华，","poem":1},{"lineBreak":true},{"text":"他就从他的圣山上应允我。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我躺下睡觉，我醒着，","poem":1},{"lineBreak":true},{"text":"耶和华都保佑我。","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"虽有成万的百姓来周围攻击我，","poem":1},{"lineBreak":true},{"text":"我也不怕。","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"耶和华啊，求你起来！","poem":1},{"lineBreak":true},{"text":"我的 神啊，求你救我！","poem":1},{"lineBreak":true},{"text":"因为你打了我一切仇敌的腮骨，","poem":1},{"lineBreak":true},{"text":"敲碎了恶人的牙齿。","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"救恩属乎耶和华；","poem":1},{"lineBreak":true},{"text":"愿你赐福给你的百姓。 （细拉）","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/3.json","thisChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/4.json","nextChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/2.json","previousChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":8,"simpleChapterApiLink":"/api/cmn_cu1/PSA/3.simple.json"}