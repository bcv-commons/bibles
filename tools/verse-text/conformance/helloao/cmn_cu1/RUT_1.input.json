{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"695cd78273e0ae8b7d4d8652df136647b8176716ed7279584f6bd047574676ff","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","completeTranslationApiLink":"/api/cmn_cu1/complete.json","simpleCompleteTranslationApiLink":"/api/cmn_cu1/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"RUT","translationId":"cmn_cu1","name":"路得记","commonName":"路得记","title":"路得记","order":8,"numberOfChapters":4,"sha256":"05afd29db818dbc98a178cad2b2a66481ac6d7e61e5eb609b4dd5dee09ef3961","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/RUT/1.json","firstChapterReference":{"translationId":"cmn_cu1","book":"RUT","chapter":1},"lastChapterNumber":4,"lastChapterApiLink":"/api/cmn_cu1/RUT/4.json","lastChapterReference":{"translationId":"cmn_cu1","book":"RUT","chapter":4},"totalNumberOfVerses":85},"chapter":{"number":1,"content":[{"type":"heading","content":["以利米勒全家迁往摩押"]},{"type":"verse","number":1,"content":["当士师秉政的时候，国中遭遇饥荒。在犹大的伯利恒，有一个人带着妻子和两个儿子往摩押地去寄居。"]},{"type":"verse","number":2,"content":["这人名叫以利米勒，他的妻名叫拿俄米；他两个儿子，一个名叫玛伦，一个名叫基连，都是犹大伯利恒的以法他人。他们到了摩押地，就住在那里。"]},{"type":"verse","number":3,"content":["后来拿俄米的丈夫以利米勒死了，剩下妇人和她两个儿子。"]},{"type":"verse","number":4,"content":["这两个儿子娶了摩押女子为妻，一个名叫俄珥巴，一个名叫路得，在那里住了约有十年。"]},{"type":"verse","number":5,"content":["玛伦和基连二人也死了，剩下拿俄米，没有丈夫，也没有儿子。"]},{"type":"heading","content":["拿俄米和路得回伯利恒"]},{"type":"verse","number":6,"content":["她就与两个儿妇起身，要从摩押地归回；因为她在摩押地听见耶和华眷顾自己的百姓，赐粮食与他们。"]},{"type":"verse","number":7,"content":["于是她和两个儿妇起行离开所住的地方，要回犹大地去。"]},{"type":"verse","number":8,"content":["拿俄米对两个儿妇说：「你们各人回娘家去吧。愿耶和华恩待你们，像你们恩待已死的人与我一样！"]},{"type":"verse","number":9,"content":["愿耶和华使你们各在新夫家中得平安！」于是拿俄米与她们亲嘴。她们就放声而哭，"]},{"type":"verse","number":10,"content":["说：「不然，我们必与你一同回你本国去。」"]},{"type":"verse","number":11,"content":["拿俄米说：「我女儿们哪，回去吧！为何要跟我去呢？我还能生子作你们的丈夫吗？"]},{"type":"verse","number":12,"content":["我女儿们哪，回去吧！我年纪老迈，不能再有丈夫；即或说，我还有指望，今夜有丈夫可以生子，"]},{"type":"verse","number":13,"content":["你们岂能等着他们长大呢？你们岂能等着他们不嫁别人呢？我女儿们哪，不要这样。我为你们的缘故甚是愁苦，因为耶和华伸手攻击我。」"]},{"type":"verse","number":14,"content":["两个儿妇又放声而哭，俄珥巴与婆婆亲嘴而别，只是路得舍不得拿俄米。"]},{"type":"verse","number":15,"content":["拿俄米说：「看哪，你嫂子已经回她本国和她所拜的神那里去了，你也跟着你嫂子回去吧！」"]},{"type":"verse","number":16,"content":["路得说：「不要催我回去不跟随你。你往哪里去，我也往那里去；你在哪里住宿，我也在那里住宿；你的国就是我的国，你的 神就是我的 神。"]},{"type":"verse","number":17,"content":["你在哪里死，我也在那里死，也葬在那里。除非死能使你我相离！不然，愿耶和华重重地降罚与我。」"]},{"type":"verse","number":18,"content":["拿俄米见路得定意要跟随自己去，就不再劝她了。"]},{"type":"verse","number":19,"content":["于是二人同行，来到伯利恒。她们到了伯利恒，合城的人就都惊讶。妇女们说：「这是拿俄米吗？」"]},{"type":"verse","number":20,"content":["拿俄米对她们说：「不要叫我拿俄米",{"noteId":0},"，要叫我玛拉",{"noteId":1},"，因为全能者使我受了大苦。"]},{"type":"verse","number":21,"content":["我满满地出去，耶和华使我空空地回来。耶和华降祸与我；全能者使我受苦。既是这样，你们为何还叫我拿俄米呢？」"]},{"type":"verse","number":22,"content":["拿俄米和她儿妇摩押女子路得，从摩押地回来到伯利恒，正是动手割大麦的时候。"]}],"footnotes":[{"noteId":0,"caller":"-","text":"就是甜的意思","reference":{"chapter":1,"verse":20}},{"noteId":1,"caller":"-","text":"就是苦的意思","reference":{"chapter":1,"verse":20}}]},"thisChapterLink":"/api/cmn_cu1/RUT/1.json","thisChapterReference":{"translationId":"cmn_cu1","book":"RUT","chapter":1},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/RUT/2.json","nextChapterReference":{"translationId":"cmn_cu1","book":"RUT","chapter":2},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JDG/21.json","previousChapterReference":{"translationId":"cmn_cu1","book":"JDG","chapter":21},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":22,"simpleChapterApiLink":"/api/cmn_cu1/RUT/1.simple.json"}