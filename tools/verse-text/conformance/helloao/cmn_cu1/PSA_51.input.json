{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"695cd78273e0ae8b7d4d8652df136647b8176716ed7279584f6bd047574676ff","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","completeTranslationApiLink":"/api/cmn_cu1/complete.json","simpleCompleteTranslationApiLink":"/api/cmn_cu1/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"5b0940ed754218d066d154fc363276ff3bd7cbcc75f1f003dd9ec97171117347","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","firstChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","lastChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":150},"totalNumberOfVerses":2452},"chapter":{"number":51,"content":[{"type":"heading","content":["求主赦免"]},{"type":"hebrew_subtitle","content":["大卫与拔示巴同室以后，先知拿单来见他；他作这诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你按你的慈爱怜恤我！","poem":1},{"lineBreak":true},{"text":"按你丰盛的慈悲涂抹我的过犯！","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"求你将我的罪孽洗除净尽，","poem":1},{"lineBreak":true},{"text":"并洁除我的罪！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因为，我知道我的过犯；","poem":1},{"lineBreak":true},{"text":"我的罪常在我面前。","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"我向你犯罪，惟独得罪了你；","poem":1},{"lineBreak":true},{"text":"在你眼前行了这恶，","poem":1},{"lineBreak":true},{"text":"以致你责备我的时候显为公义，","poem":1},{"lineBreak":true},{"text":"判断我的时候显为清正。","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"我是在罪孽里生的，","poem":1},{"lineBreak":true},{"text":"在我母亲怀胎的时候就有了罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你所喜爱的是内里诚实；","poem":1},{"lineBreak":true},{"text":"你在我隐密处，必使我得智慧。","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"求你用牛膝草洁净我，我就干净；","poem":1},{"lineBreak":true},{"text":"求你洗涤我，我就比雪更白。","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"求你使我得听欢喜快乐的声音，","poem":1},{"lineBreak":true},{"text":"使你所压伤的骨头可以踊跃。","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"求你掩面不看我的罪，","poem":1},{"lineBreak":true},{"text":"涂抹我一切的罪孽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"神啊，求你为我造清洁的心，","poem":1},{"lineBreak":true},{"text":"使我里面重新有正直","poem":1},{"noteId":24},{"text":"的灵。","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"不要丢弃我，使我离开你的面；","poem":1},{"lineBreak":true},{"text":"不要从我收回你的圣灵。","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"求你使我仍得救恩之乐，","poem":1},{"lineBreak":true},{"text":"赐我乐意的灵扶持我，","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我就把你的道指教有过犯的人，","poem":1},{"lineBreak":true},{"text":"罪人必归顺你。","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"神啊，你是拯救我的 神；","poem":1},{"lineBreak":true},{"text":"求你救我脱离流人血的罪！","poem":1},{"lineBreak":true},{"text":"我的舌头就高声歌唱你的公义。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"主啊，求你使我嘴唇张开，","poem":1},{"lineBreak":true},{"text":"我的口便传扬赞美你的话！","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"你本不喜爱祭物，若喜爱，我就献上；","poem":1},{"lineBreak":true},{"text":"燔祭，你也不喜悦。","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"神所要的祭就是忧伤的灵；","poem":1},{"lineBreak":true},{"text":"神啊，忧伤痛悔的心，你必不轻看。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"求你随你的美意善待锡安，","poem":1},{"lineBreak":true},{"text":"建造耶路撒冷的城墙。","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"那时，你必喜爱公义的祭","poem":1},{"lineBreak":true},{"text":"和燔祭并全牲的燔祭；","poem":1},{"lineBreak":true},{"text":"那时，人必将公牛献在你坛上。","poem":1}]}],"footnotes":[{"noteId":24,"caller":"-","text":"或译：坚定","reference":{"chapter":51,"verse":10}}]},"thisChapterLink":"/api/cmn_cu1/PSA/51.json","thisChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":51},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/52.json","nextChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":52},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/50.json","previousChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":50},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":19,"simpleChapterApiLink":"/api/cmn_cu1/PSA/51.simple.json"}