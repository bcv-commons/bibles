{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"0ff816e67f107d814212814ad1859d808838689b53a23c37ac041b472d37c641","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","completeTranslationApiLink":"/api/guj_irv/complete.json","simpleCompleteTranslationApiLink":"/api/guj_irv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"86e8ca2da22da75977479635af0f0ccbfbd5269df1ccc5eaede4fded48bb981a","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","firstChapterReference":{"translationId":"guj_irv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","lastChapterReference":{"translationId":"guj_irv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["સહાય માટે સવારની પ્રાર્થના"]},{"type":"hebrew_subtitle","content":["પોતાના દીકરા આબ્શાલોમથી નાસી જતી વખતનું દાઉદનું ગીત."]},{"type":"verse","number":1,"content":[{"text":"હે યહોવાહ, મારા વેરીઓ કેટલા બધા વધી ગયા છે!","poem":1},{"lineBreak":true},{"text":"મારી સામે હુમલો કરનારા ઘણા છે.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"ઘણા મારા વિષે કહે છે,","poem":1},{"lineBreak":true},{"text":"“ઈશ્વર તરફથી તેને કોઈ મદદ મળશે નહિ.” સેલાહ","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"પણ હે યહોવાહ તમે મારી આસપાસ ઢાલરૂપ છો,","poem":1},{"lineBreak":true},{"text":"તમે મારું ગૌરવ તથા મારું માથું ઊંચું કરનાર છો.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"હું મારી વાણીથી યહોવાહને વિનંતી કરું છું","poem":1},{"lineBreak":true},{"text":"અને તે પોતાના પવિત્ર પર્વત પરથી મને ઉત્તર આપે છે. સેલાહ","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"હું સૂઈને ઊંઘી ગયો;","poem":1},{"lineBreak":true},{"text":"હું જાગ્યો, કેમ કે યહોવાહ મારું રક્ષણ કરે છે.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"જે હજારો લોકોએ મને ઘેરી લીધો છે","poem":1},{"lineBreak":true},{"text":"તેઓથી હું બીશ નહિ.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"હે યહોવાહ, ઊઠો! મારા ઈશ્વર, મારો બચાવ કરો!","poem":1},{"lineBreak":true},{"text":"કેમ કે તમે મારા સર્વ શત્રુઓનાં જડબાં પર પ્રહાર કર્યો છે;","poem":1},{"lineBreak":true},{"text":"તમે દુષ્ટોના દાંત ભાંગી નાખ્યા છે.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"વિજય","poem":1},{"noteId":1},{"text":"યહોવાહ પાસેથી મળે છે.","poem":1},{"lineBreak":true},{"text":"તમારા લોકો પર તમારો આશીર્વાદ આવો. સેલાહ.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"ઉદ્ધાર","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/guj_irv/PSA/3.json","thisChapterReference":{"translationId":"guj_irv","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/4.json","nextChapterReference":{"translationId":"guj_irv","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/2.json","previousChapterReference":{"translationId":"guj_irv","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":8,"simpleChapterApiLink":"/api/guj_irv/PSA/3.simple.json"}