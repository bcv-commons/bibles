{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"19ae9102b3bf930aa9c4e664c53895f56af6e906a4971c3524f7aa97866e2ccf","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","completeTranslationApiLink":"/api/mya_ojv/complete.json","simpleCompleteTranslationApiLink":"/api/mya_ojv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ACT","translationId":"mya_ojv","name":"တမန်တော်ဝတ္ထု","commonName":"တမန်တော်ဝတ္ထု","title":"တမန်တော်ဝတ္ထု","order":44,"numberOfChapters":28,"sha256":"6c2c8fdba911c1f04684ca1c9df8c267f85d53341adae596e4d7cb80f3f3d641","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ACT/1.json","firstChapterReference":{"translationId":"mya_ojv","book":"ACT","chapter":1},"lastChapterNumber":28,"lastChapterApiLink":"/api/mya_ojv/ACT/28.json","lastChapterReference":{"translationId":"mya_ojv","book":"ACT","chapter":28},"totalNumberOfVerses":993},"chapter":{"number":8,"content":[{"type":"heading","content":["အ​သင်း​တော်​ဝင်​တို့​ကို​ရှော​လု နှိပ်​စက်​ညှဉ်း​ဆဲ​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​နေ့​မှ​စ​၍​ယေ​ရု​ရှ​လင်​မြို့​ရှိ​အ​သင်း​တော် ဝင်​အ​ပေါင်း​တို့​သည် နှိပ်​စက်​ညှဉ်း​ဆဲ​ခြင်း​ကို ပြင်း​ထန်​စွာ​ခံ​ရ​ကြ​၏။ သို့​ဖြစ်​၍​သူ​တို့​သည် ယု​ဒ​ပြည်​နှင့် ရှ​မာ​ရိ​ပြည်​များ​သို့​ကွဲ​လွင့် သွား​ကြ​ကုန်​၏။ တ​မန်​တော်​များ​သာ​လျှင် ကျန်​ရစ်​ခဲ့​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ဘု​ရား​တ​ရား​ကြည်​ညို​သူ​လူ​အ​ချို့​တို့ သည် သ​တေ​ဖန်​ကို​သင်္ဂြိုဟ်​၍​သည်း​စွာ​ငို​ကြွေး မြည်​တမ်း​ကြ​၏။"]},{"type":"verse","number":3,"content":["သို့​ရာ​တွင်​ရှော​လု​သည်​အ​သင်း​တော်​ကို ပျောက်​ပျက်​စေ​ရန်​ကြိုး​စား​လျက်​နေ​၏။ သူ သည်​တစ်​အိမ်​ပြီး​တစ်​အိမ်​ဝင်​၍ ယုံ​ကြည်​သူ အ