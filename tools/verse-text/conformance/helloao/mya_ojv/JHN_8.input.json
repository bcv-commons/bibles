{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"19ae9102b3bf930aa9c4e664c53895f56af6e906a4971c3524f7aa97866e2ccf","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","completeTranslationApiLink":"/api/mya_ojv/complete.json","simpleCompleteTranslationApiLink":"/api/mya_ojv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JHN","translationId":"mya_ojv","name":"ရှင်ယောဟန်","commonName":"ရှင်ယောဟန်","title":"ရှင်ယောဟန် ပြုစုသည့်သတင်းကောင်း","order":43,"numberOfChapters":21,"sha256":"1872d3fb9d1d1537f08a0366349dc3b307a02784e572c382eb4481bbe9c65474","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JHN/1.json","firstChapterReference":{"translationId":"mya_ojv","book":"JHN","chapter":1},"lastChapterNumber":21,"lastChapterApiLink":"/api/mya_ojv/JHN/21.json","lastChapterReference":{"translationId":"mya_ojv","book":"JHN","chapter":21},"totalNumberOfVerses":868},"chapter":{"number":8,"content":[{"type":"heading","content":["မျောက်​မ​ထား​နေ​စဉ် အ​ဖမ်း​ခံ​ရ​သည့်​အ​မျိုး​သ​မီး"]},{"type":"verse","number":1,"content":["ထို​နောက်​သူ​တို့​သည်​မိ​မိ​တို့​အိမ်​သို့​အ​သီး သီး​ပြန်​သွား​ကြ​၏။ သ​ခင်​ယေ​ရှု​မူ​ကား သံ​လွင်​တောင်​သို့​ကြွ​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["နောက်​တစ်​နေ့​နံ​နက်​စော​စော​ဗိ​မာန်​တော်​သို့ တစ်​ဖန်​ကြွ​တော်​မူ​သော​အ​ခါ လူ​အ​ပေါင်း​တို့ သည်​အ​ထံ​တော်​သို့​လာ​ကြ​၏။ ကိုယ်​တော်​သည် ထိုင်​တော်​မူ​လျက်​ထို​သူ​တို့​အား​ဟော​ပြော သွန်​သင်​တော်​မူ​၏။-"]},{"type":"verse","number":3,"content":["ကျမ်း​တတ်​ဆ​ရာ​များ​နှင့်​ဖာ​ရိ​ရှဲ​များ​သည် အ​မျိုး​သ​မီး​တစ်​ယောက်​ကို​အ​ထံ​တော်​သို့ ခေါ်​ခဲ့​ကြ​၏။ သူ​သည်​မျောက်​မ​ထား​နေ​စဉ် အ​ဖမ်း​ခံ​ရ​ခြင်း​ဖြစ်​၏။ ကျမ်း​တတ်​ဆ