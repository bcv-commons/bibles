{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"19ae9102b3bf930aa9c4e664c53895f56af6e906a4971c3524f7aa97866e2ccf","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","completeTranslationApiLink":"/api/mya_ojv/complete.json","simpleCompleteTranslationApiLink":"/api/mya_ojv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"3JN","translationId":"mya_ojv","name":"၃ ယော","commonName":"၃ ယော","title":"ရှင်​ယော​ဟန်​သြ​ဝါ​ဒ​စာ​တ​တိ​ယ​စောင်","order":64,"numberOfChapters":1,"sha256":"82bb76a50fa7caf52ae83b640119ad24737fd735e079d86be00ac1c7f76f34fc","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/3JN/1.json","firstChapterReference":{"translationId":"mya_ojv","book":"3JN","chapter":1},"lastChapterNumber":1,"lastChapterApiLink":"/api/mya_ojv/3JN/1.json","lastChapterReference":{"translationId":"mya_ojv","book":"3JN","chapter":1},"totalNumberOfVerses":15},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["အ​သက်​ကြီး​သူ​ထံ​မှ​အ​မှန်​ပင်​သမ္မာ​တ​ရား တော်​အား​ဖြင့် ငါ​ချစ်​မြတ်​နိုး​သူ​ဂါ​ယု​ထံ သို့​စာ​ရေး​လိုက်​သည်။"]},{"type":"verse","number":2,"content":["ချစ်​ဆွေ၊ သင်​သည်​အ​စ​စ​အ​ရာ​ရာ​တွင် ကြီး​ပွား​တိုး​တက်​၍​ကျန်း​မာ​ရွှင်​လန်း​စေ ရန်​ငါ​ဆု​တောင်း​၏။ သင်​၏​ဝိ​ညာဉ်​ပါ​ရ​မီ တိုး​တက်​လျက်​ရှိ​ကြောင်း​ငါ​သိ​၏။-"]},{"type":"verse","number":3,"content":["သင်​သည်​သမ္မာ​တ​ရား​ကို​အ​မြဲ​လိုက်​နာ​ခဲ့ သည့်​အ​တိုင်း ယ​ခု​လည်း​သစ္စာ​နှင့်​လိုက်​နာ​ကျင့် သုံး​လျက်​ရှိ​ကြောင်း​ကို ညီ​အစ်​ကို​အ​ချို့​တို့ လာ​ရောက်​ပြော​ပြ​၍​ကြား​ရ​သ​ဖြင့်​ငါ သည်​အ​လွန်​ဝမ်း​မြောက်​၏။-"]},{"type":"verse","number":4,"content":["ငါ့​အား​ဝမ်း​အ​မြောက်​ဆုံး​ဖြစ်​စေ​သည့်​အ​ရာ မှာ သမ္မာ​တ​ရား​ကို​ငါ့​သား​သ​မီး​များ​လိုက် နာ​ကျင့်​သုံး​ကြ​ကြောင်း​သ​တင်း​ကို​ကြား​ရ ခြင်း​ပင်​ဖြစ်​သည်။"]},{"type":"line_break"},{"type":"heading","content":["ဂါ​ယု​ကို​ချီး​မွမ်း​ခြင်း"]},{"type":"verse","number":5,"content":["ချစ်​ဆွေ၊ သင်​သည်​မိ​မိ​မ​သိ​မ​ကျွမ်း​သူ​ညီ အစ်​ကို​များ​ကို​ပင်​လျှင် သင်​ပြု​ရ​မည့်​ဝတ်​ကို သစ္စာ​နှင့်​ဆောင်​ရွက်​ပေ​သည်။-"]},{"type":"verse","number":6,"content":["ထို​သူ​တို့​သည်​သင်​၏​မေတ္တာ​အ​ကြောင်း​ကို ဤ အ​သင်း​တော်​ရှေ့​၌​သက်​သေ​ခံ​ကြ​လေ​ပြီ။ သူ တို့​သည်​ရှေ့​သို့​ခ​ရီး​ဆက်​နိုင်​ကြ​စေ​ရန်​သူ တို့​အား​ဘု​ရား​သ​ခင်​နှစ်​သက်​တော်​မူ​သည့် အ​တိုင်း​ကူ​ညီ​မ​စ​ပါ​လော့။-"]},{"type":"verse","number":7,"content":["သူ​တို့​သည်​ယုံ​ကြည်​သူ​မ​ဟုတ်​သူ​များ​ထံ​မှ အ​ကူ​အ​ညီ​ကို​မ​ယူ​ဘဲ နာ​မ​တော်​အ​ကြောင်း ဟော​ပြော​ရန်​ခ​ရီး​ထွက်​ကြ​သူ​များ​ဖြစ်​ပေ သည်။-"]},{"type":"verse","number":8,"content":["သို့​ဖြစ်​၍​ငါ​တို့​များ​သည်​သမ္မာ​တ​ရား​ပြန့် ပွား​ရေး​လုပ်​ငန်း​တွင် ထို​သူ​တို့​၏​လုပ်​ဖော် ဆောင်​ဘက်​များ​ဖြစ်​နိုင်​ရန်​သူ​တို့​အား​ကူ​ညီ မ​စ​ရ​မည်။"]},{"type":"line_break"},{"type":"heading","content":["ဒ​ယော​တ​ရပ်​နှင့်​ဒေ​မေ​တ​ရိ"]},{"type":"verse","number":9,"content":["ငါ​သည်​အ​သင်း​တော်​သို့​စာ​ရေး​ခဲ့​သော် လည်း အ​သင်း​တော်​၏​ခေါင်း​ဆောင်​ဖြစ်​လို သူ​ဒ​ယော​တ​ရပ်​က​ငါ့​စ​ကား​ကို​မ​နာ ခံ။-"]},{"type":"verse","number":10,"content":["သို့​ဖြစ်​၍​ငါ​လာ​သော​အ​ခါ​မှ​သူ​ပြု​သ​မျှ သော​အ​မှု​တို့​ကို​ထုတ်​ဖော်​ပြော​ဆို​မည်။ သူ သည်​ငါ​တို့​အား​မ​လို​မုန်း​ထား​စွပ်​စွဲ​ပြော ဆို​၏။ ဤ​မျှ​နှင့်​မ​ကျေ​နပ်​သေး​ဘဲ​သူ​ကိုယ် တိုင်​ပင်​လျှင် ညီ​အစ်​ကို​များ​ကို​လက်​မ​ခံ၊ လက်​ခံ​လို​သူ​များ​အား​လည်း​တား​မြစ် လျက်​အ​သင်း​တော်​မှ​နှင်​ထုတ်​ရန်​ကြိုး စား​၏။"]},{"type":"verse","number":11,"content":["ချစ်​ဆွေ၊ စံ​န​မူ​နာ​ကောင်း​ကို​အ​တု​ယူ​ပါ။ စံ​န​မူ​နာ​ဆိုး​ကို​အ​တု​မ​ယူ​နှင့်။ အ​ကျင့် ကောင်း​ကို​ပြု​ကျင့်​သူ​သည်​ဘု​ရား​သ​ခင်​၏ ဘက်​တော်​သား​ဖြစ်​၏။ အ​ကျင့်​ဆိုး​ကို​ပြု ကျင့်​သူ​ကား​ဘု​ရား​သ​ခင်​ကို​မ​သိ​မြင် သေး​သူ​ဖြစ်​၏။"]},{"type":"verse","number":12,"content":["ဒေ​မေ​တ​ရိ​ကို လူ​တိုင်း​ချီး​မွမ်း​ပြော​ဆို ကြ​ပေ​သည်။ သမ္မာ​တ​ရား​သည်​သူ့​ဘက်​၌ သက်​သေ​ခံ​၏။ ငါ​တို့​သည်​ထပ်​လောင်း​၍ ထောက်​ခံ​၏။ ငါ​တို့​ထောက်​ခံ​ချက်​သည် ခိုင်​လုံ​ကြောင်း​သင်​သိ​၏။"]},{"type":"line_break"},{"type":"heading","content":["နောက်​ဆုံး​နှုတ်​ဆက်​စ​ကား​များ"]},{"type":"verse","number":13,"content":["သင်​တို့​အား​ပြော​စ​ရာ​အ​ကြောင်း​အ​ရာ များ​စွာ​ရှိ​သော်​လည်း​ငါ​သည်​စာ​အား​ဖြင့် မ​ရေး​ဘဲ၊-"]},{"type":"verse","number":14,"content":["ငါ​သည်​သင့်​ထံ​သို့​မ​ကြာ​မီ​ရောက်​၍​သင်​နှင့် မျက်​နှာ​စုံ​ညီ​တွေ့​ဆုံ​ပြော​ဆို​နိုင်​လိမ့်​မည်​ဟု မျှော်​လင့်​၏။"]},{"type":"verse","number":15,"content":["သင်​၌​ငြိမ်​သက်​ခြင်း​ရှိ​ပါ​စေ​သော။ ဤ​အ​ရပ်​ရှိ​မိတ်​ဆွေ​များ​က​သင့်​အား​နှုတ် ဆက်​ကြ​၏။ ငါ​တို့​၏​မိတ်​ဆွေ​တစ်​ဦး​စီ​အား နှုတ်​ဆက်​ပါ​လော့။ ရှင်​ယော​ဟန်​သြ​ဝါ​ဒ​စာ​တ​တိ​ယ​စောင်​ပြီး​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/3JN/1.json","thisChapterReference":{"translationId":"mya_ojv","book":"3JN","chapter":1},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/JUD/1.json","nextChapterReference":{"translationId":"mya_ojv","book":"JUD","chapter":1},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/2JN/1.json","previousChapterReference":{"translationId":"mya_ojv","book":"2JN","chapter":1},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":15,"simpleChapterApiLink":"/api/mya_ojv/3JN/1.simple.json"}