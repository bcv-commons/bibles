{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"19ae9102b3bf930aa9c4e664c53895f56af6e906a4971c3524f7aa97866e2ccf","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","completeTranslationApiLink":"/api/mya_ojv/complete.json","simpleCompleteTranslationApiLink":"/api/mya_ojv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"15184f6cc3719b48f2967121a1109208fbe9186f32f2d6e8e2301df83de633e1","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","firstChapterReference":{"translationId":"mya_ojv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","lastChapterReference":{"translationId":"mya_ojv","book":"PSA","chapter":150},"totalNumberOfVerses":2401},"chapter":{"number":3,"content":[{"type":"heading","content":["ကယ်​မ​တော်​မူ​ရန်​နံ​နက်​ချိန်​ဆု​တောင်း ပတ္ထ​နာ3:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​၏​သား​တော်​အ​ဗ​ရှ​လုံ​ထံ​မှ​ထွက်​ပြေး သော​အ​ခါ​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား၊ ကျွန်​တော်​မျိုး​တွင်​ရန်​သူ​များ​စွာ​ရှိ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တစ်​ဘက်​၌​ထ​ကြွ​သူ​များ​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"သူ​တို့​က​ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​ကို","poem":1},{"text":"ကူ​မ​တော်​မူ​လိမ့်​မည်​မ​ဟုတ်​ကြောင်း ပြော​ဆို​ကြ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"သို့​ရာ​တွင် အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​သည်​ဒိုင်း​လွှား​သ​ဖွယ်​ကျွန်​တော်​မျိုး အား ဘေး​ရန်​များ​မှ​အ​စဉ်​ကွယ်​ကာ​တော်​မူ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​အား​အောင်​ပွဲ​ကို","poem":1},{"text":"ပေး​တော်​မူ​လျက်​ရဲ​စွမ်း​သတ္တိ​နှင့်​ပြန်​လည် ပြည့်​ဝ​စေ​တော်​မူ​ပါ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​ထံ​တော်​သို့​ကူ​မ တော်​မူ​ရန် ဟစ်​အော်​တောင်း​လျှောက်​သည့်​အ​ခါ","poem":1},{"text":"ကိုယ်​တော်​သည်​သန့်​ရှင်း​မြင့်​မြတ်​ရာ​တောင်​ပေါ်​မှ","poem":2},{"text":"ငါ​၏​ဆု​တောင်း​ပတ္ထနာ​သံ​ကို​နား​ညောင်း​တော်​မူ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​ကို​ကွယ်​ကာ","poem":1},{"text":"စောင့်​ထိန်း​တော်​မူ​သော​ကြောင့်​ငါ​သည်​လဲ​လျောင်း အိပ်​ပျော်​ခွင့်​ကို​ရ​ရှိ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"မိ​မိ​ပတ်​လည်​တွင်​ဝိုင်း​ရံ​လျက်​ရှိ​သော","poem":1},{"text":"ရန်​သူ​ထောင်​သောင်း​များ​စွာ​တို့​ကို ငါ​သည်​မ​ကြောက်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကြွ​လာ​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရား​သ​ခင်၊​ကျွန်​တော်​မျိုး​အား ကယ်​တော်​မူ​ပါ။","poem":2},{"text":"ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​၏​ရန်​သူ​အ​ပေါင်း​တို့​၏ ပါး​ရိုး​ကို​ရိုက်​၍​သူ​တို့​၏​သွား​ကို​ချိုး​တော်​မူ​၏။","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​အောင်​ပွဲ​ကို​ပေး​ပိုင်​သော အ​ရှင်​ဖြစ်​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​၏​လူ​စု​တော်​အ​ပေါ်​သို့ ကောင်း​ချီး​မင်္ဂလာ​သက်​ရောက်​ပါ​စေ​သော။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/3.json","thisChapterReference":{"translationId":"mya_ojv","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/4.json","nextChapterReference":{"translationId":"mya_ojv","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/2.json","previousChapterReference":{"translationId":"mya_ojv","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimin