:1},{"text":"ሜቄያና ሂርኪ ጌዔ ዒና ዒዚ ቦሁዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ፆኦዛሢዮ!","poem":1},{"text":"ፂዮኔ ማኣዳኒ፥ ዬሩሳላሜኮዋ ኬኤሎ ዲፆ ኮሻኒ","poem":2},{"lineBreak":true},{"text":"ሃዳራ ኔኤኒ ጌዔሢጉዲ ማዖንጎ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዬማ ዎዶና ፒዜ ዒንጎ ዒንጊፆንታ","poem":1},{"text":"ሚቺ ዒንጎ ዒንጊፆናኣ ኔኤኒ ዎዛዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኑኡኒያ ኔኤም ዒንጎ ባኮ ዒንጎ ቤዛ ዚዮ ጌማቶ ሺኢሻንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/51.json","thisChapterReference":{"translationId":"mdy_twf","book":"PSA","chapter":51},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/52.json","nextChapterReference":{"translationId":"mdy_twf","book":"PSA","chapter":52},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/50.json","previousChapterReference":{"translationId":"mdy_twf","book":"PSA","chapter":50},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":19,"simpleChapterApiLink":"/api/mdy_twf/PSA/51.simple.json"}