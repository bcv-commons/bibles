line_break"},{"type":"verse","number":5,"content":[{"text":"ታ ላሃኔ፥ ጊንዓኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዋንቶ ቢያ ታና ካፔሢሮ","poem":2},{"lineBreak":true},{"text":"ጊንዓስካፓኣ ጊንሣ ታኣኒ ጴጫኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዓጮ ታኣኮ ማንጊ ዓኣ","poem":1},{"text":"ፓይዲንቱዋ ታ ሞርኮ ታኣኒ ዒጊጩዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዔቄ!","poem":1},{"text":"ታ ፆኦዛሢዮ! ሙኪ ታና ዓውሴ!","poem":2},{"lineBreak":true},{"text":"ታ ሞርኮኮ ባንጋሎ ሜንሤ፤","poem":2},{"lineBreak":true},{"text":"ዓጮዋ ዔያቶኮ ኬይሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዓሲ ዓውሳይ ናንጊና ናንጋ ጎዳኬ፤","poem":1},{"text":"ፆኦሲዮ! ዓንጃ ኔኤሲ ኔ ዴሮም ማዖንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/3.json","thisChapterReference":{"translationId":"mdy_twf","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/4.json","nextChapterReference":{"translationId":"mdy_twf","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/2.json","previousChapterReference":{"translationId":"mdy_twf","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":8,"simpleChapterApiLink":"/api/mdy_twf/PSA/3.simple.json"}